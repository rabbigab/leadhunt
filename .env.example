# Telethon — obtenable sur https://my.telegram.org/apps
API_ID=
API_HASH=

# Session Telethon en chaîne de caractères (généré par convert_session.py)
SESSION_STRING=

# Token du bot Telegram (@BotFather) — utilisé pour poster sur les canaux
BOT_TOKEN=

# Clé API Anthropic — obtenable sur https://console.anthropic.com/
ANTHROPIC_API_KEY=

# IDs des groupes/canaux Telegram
SOURCE_GROUP_ID=
PRIVATE_CHANNEL_ID=
PUBLIC_CHANNEL_ID=

# Termes à bloquer (séparés par virgules, insensible à la casse)
# Layer 1 : ignorés sur le texte source brut
# Layer 3 : retirés du texte reformaté avant publication
# Exemple : SOURCE_BLOCKLIST=nom_du_groupe,@username,lien_invite
SOURCE_BLOCKLIST=

# X (Twitter) — obtenable sur https://developer.twitter.com/en/portal
# Laisser vide pour désactiver le posting X
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# URL du canal Telegram public (ajoutée en fin de tweet)
TELEGRAM_CHANNEL_URL=https://t.me/latelierdutraderfr
