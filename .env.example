# Telegram — créer un bot via @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_CHAT_ID=123456789

# --- PROXIES RÉSIDENTIELS (fortement recommandé en production) ---
# Format : http://user:password@host:port
# ou socks5://user:password@host:port
#
# MVP sans proxy (test local uniquement) :
PROXY_ENABLED=false
PROXY_LIST=
#
# MVP avec 1 proxy résidentiel (ex: Webshare, Bright Data, Oxylabs) :
# PROXY_ENABLED=true
# PROXY_LIST=http://user:pass@proxy1.brightdata.com:22225
#
# Production multi-proxy (rotation automatique) :
# PROXY_ENABLED=true
# PROXY_LIST=http://u:p@proxy1.host:8080,http://u:p@proxy2.host:8080,http://u:p@proxy3.host:8080

# Options scraper
LOG_LEVEL=INFO
HEADLESS=true     # mettre false pour déboguer en local
