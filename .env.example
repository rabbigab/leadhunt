SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Facebook — COMPTE SECONDAIRE DÉDIÉ UNIQUEMENT, jamais le compte principal
FB_EMAIL=moncompte.secondaire@email.com
